# URL do projeto Supabase (Project Settings > API > Project URL)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chave anônima/pública do Supabase (Project Settings > API > anon public)
SUPABASE_ANON_KEY=

# Porta em que o servidor Express vai rodar localmente
PORT=3001

# URL(s) do front-end autorizadas pelo CORS. Separe por vírgula se precisar de mais de uma.
# Em produção, use a URL do deploy na Vercel (ex: https://controlefinanceiro.vercel.app)
FRONTEND_URL=http://localhost:3000
